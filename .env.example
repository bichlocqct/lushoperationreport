# Cấu hình PostgreSQL Connection String
# Ví dụ local: postgresql://postgres:postgres@localhost:5432/report_lush
# Ví dụ Cloud (Supabase/Neon): postgres://<username>:<password>@<host>/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/report_lush
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/report_lush

# Cổng khởi chạy cho local server
PORT=3000
